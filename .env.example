# Slider — variables d'environnement
# Copiez ce fichier en `.env` et renseignez vos clés (jamais commitées).

# Clé API Gemini (strictement côté serveur, jamais exposée au client)
GEMINI_API_KEY=

# Clé API DeepSeek (fallback OpenAI-compatible, strictement côté serveur)
DEEPSEEK_API_KEY=

# Port du serveur Express (par défaut 8787)
PORT=8787

# ID client Google OAuth (pour l'export Google Slides)
VITE_GOOGLE_CLIENT_ID=

# Clé d'accès Unsplash (optionnelle, pour les images éditoriales)
UNSPLASH_ACCESS_KEY=

# NetWallet Pay (paiement / abonnement mensuel 2500 FCFA)
NETWALLET_PRIMARY_KEY=
NETWALLET_SECONDARY_KEY=
NETWALLET_EMAIL=
# À mettre à "true" UNIQUEMENT si le hash est activé dans le dashboard NetWallet
NETWALLET_HASH_ENABLED=false
# Prix de l'abonnement en FCFA (défaut 2500) et durée en jours (défaut 30)
SUBSCRIPTION_PRICE_XAF=2500
SUBSCRIPTION_DAYS=30
# Prix d'un export à l'acte (défaut 250) et quota quotidien de génération IA (défaut 15)
EXPORT_PRICE_XAF=250
DAILY_SLIDE_LIMIT=15
